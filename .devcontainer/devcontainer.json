{
  "name": "Blind Eternities (Rust + Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    // 1. Install the Rust toolchain (Cargo, rustc)
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal"
    },
    // 2. Install ZSH and standard dev utilities
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "upgradePackages": true
    },
    // 3. Install Go-Task
    "ghcr.io/devcontainers-extra/features/go-task:1": {
        "version": "latest"
    }
  },
  "runArgs": [
    "--shm-size=8g",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        // Disable the built-in AI Chat and Speech features
        "chat.disableAIFeatures": true,
        "accessibility.voice.keywordActivation": "off",

        // Explicitly kill Copilot across all languages
        "github.copilot.enable": {
            "*": false,
            "plaintext": false,
            "markdown": false,
            "scminput": false
        },
        "github.copilot.editor.enableAutoCompletions": false,
        "github.copilot.editor.enableCodeActions": false,

        // Disable the "ghost text" inline suggestions
        "editor.inlineSuggest.enabled": false,

        // Disable the suggestion to use Copilot when using the integrated terminal
        "terminal.integrated.initialHint": false,

        // Ensure standard Intellisense still works (manual triggers)
        "editor.suggestOnTriggerCharacters": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },

        "python.terminal.activateEnvInCurrentTerminal": true,
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "rust-lang.rust-analyzer",  // Official Rust Language Server
        "vadimcn.vscode-lldb",      // Native debugger (Critical for Rust)
        "tamasfe.even-better-toml", // Best TOML support
        "fill-labs.dependi",        // REPLACES 'crates': Manages Cargo dependencies
        "ms-python.python",         // Python language support
        "ms-python.vscode-pylance", // Type checking
        "charliermarsh.ruff",       // High-performance Python linter

        // --- Markdown Tools ---
        "DavidAnson.vscode-markdownlint",  // The Style Enforcer
        "yzhang.markdown-all-in-one",      // The Productivity Suite
        "bierner.markdown-mermaid",        // Better Mermaid Preview Support

        // --- GoTask ---
        "redhat.vscode-yaml",
        "task.vscode-task",

        // --- Docker Container Tools ---
        "ms-azuretools.vscode-containers"
      ]
    }
  },
  // 4. Hardened System Dependencies & Venv Bootstrap
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y protobuf-compiler patchelf build-essential pkg-config libssl-dev && python3 -m venv .venv && ./.venv/bin/pip install --upgrade pip && ./.venv/bin/pip install -r requirements.txt",
  
  // 5. Set the user to 'vscode' (standard for devcontainers) to avoid permission issues
  "remoteUser": "vscode"
}